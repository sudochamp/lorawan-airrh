	)
	(text "LIS2DW12: CS and SA0 have ~20.4k INTERNAL pull-ups to VDD_IO. \nThey MUST be tied HIGH, not low - pulling either low sinks\n3.3V/20.4k = 162 uA continuously (1418 mAh/yr, > whole battery)."
		(exclude_from_sim no)
		(at 12.688 247.142 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
