	(text "VSET is LEFT UNCONNECTED -> boost starts at 3.0 V (grounding it would give 1.8 V).\nRAK811 VCC spec is 3.15-3.45 V, so firmware MUST raise BOOST.VOUT to 3.3 V over I2C\nbefore the first LoRa TX. VSET itself cannot select 3.3 V - only 3.0 V or 1.8 V.\nSYSGDEN grounded: boot monitor disabled."
		(exclude_from_sim no)
		(at 64.516 91.694 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b0979bdb-d602-4229-95cf-d026016a29c4")
	)
	(text "NOTE: Isat is only 300 mA - confirm booster peak current at bring-up."
		(exclude_from_sim no)
		(at 329.84 247.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bbd923df-da46-4b31-8d5b-d1d1031002fe")
	)
