				(size 1.27 1.27)
			)
		)
		(uuid "bdf3bcff-c17f-49ab-99de-d5ff0f128fbb")
	)
	(text "U6 OPT3004: ADDR tied HIGH -> I2C 0x45. ADDR low would be 0x44,\nwhich is the SHT45's address. Needs a clear optical path in the\nenclosure - do not place under the display."
		(exclude_from_sim no)
		(at 240.076 78.74 0)
		(effects
